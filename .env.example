# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHOP_API_KEY (Optional): Whop Developer API Key for live syncing products
# Configured in server environment or Settings > Secrets. Never exposed to browser.
WHOP_API_KEY=""

# WHOP_COMPANY_ID (Optional): Your Whop Organization / Company ID (e.g., biz_xxxx)
WHOP_COMPANY_ID=""

# WHOP_WEBHOOK_SECRET (Optional): Whop Webhook Signature Secret for payment.succeeded
WHOP_WEBHOOK_SECRET=""

# SUPABASE_URL (Optional): Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""

# SUPABASE_ANON_KEY (Optional): Supabase Public Anon Key
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY (Optional): Supabase Service Role Key (for backend server writes)
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL (Optional): Direct PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@db.xyzcompany.supabase.co:5432/postgres"

